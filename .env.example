APP_NAME=Saloenza
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=brevo
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Brevo transactional API key (xkeysib-...) — not the SMTP key (xsmtpsib-...).
# Create under Brevo → SMTP & API → API keys. Mail uses .env only (no settings UI).
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OTP_CODE_EXPIRY_MINUTES=10
OTP_ALLOW_DEVELOPMENT_MASTER_CODE=false
OTP_DEVELOPMENT_MASTER_CODE=0101
OTP_EXPOSE_CODE_IN_RESPONSE=false
OTP_EMAIL_DRIVER=log
OTP_SMS_DRIVER=log
OTP_AWS_REGION=${AWS_DEFAULT_REGION}
OTP_AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
OTP_AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
OTP_AWS_SES_FROM_EMAIL="hello@example.com"
OTP_AWS_SES_FROM_NAME="${APP_NAME}"
OTP_AWS_SMS_SENDER_ID=
OTP_AWS_SMS_TYPE=Transactional

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}/api"
VITE_USE_MOCK_AUTH=false

# Payment / subscription upgrades
# manual = offline collection + platform admin approval
# razorpay = online checkout when keys are set below
PAYMENT_DRIVER=manual
PAYMENT_CURRENCY=INR
PAYMENT_ALLOW_INSTANT_UPGRADE=false
PAYMENT_MANUAL_ALLOW_TENANT_REQUESTS=true
PAYMENT_MANUAL_INSTRUCTIONS="Submit an upgrade request. Our team will confirm after offline payment (cash, UPI, or bank transfer)."
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_COMPANY_NAME="${APP_NAME}"

# Stripe (set PAYMENT_DRIVER=stripe)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMPANY_NAME="${APP_NAME}"
STRIPE_SUCCESS_URL="${APP_URL}/billing"
STRIPE_CANCEL_URL="${APP_URL}/billing"
